{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yodawy-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yodawy-dashboard",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}