{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yodawy-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/site-access.json"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yodawy-dashboard",
      "database_id": "7a4fd7ce-fdef-4f99-8927-97bdeb8c5083",
      "migrations_dir": "./migrations"
    }
  ]
}