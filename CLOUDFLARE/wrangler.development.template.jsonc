{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yodawy-dashboard-dev",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "YODAWY_ENVIRONMENT": "DEVELOPMENT",
    "ALLOWED_ORIGINS": "__DEV_ALLOWED_ORIGINS__"
  },
  "assets": {
    "directory": "./.dev-build/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/site-access.json",
      "/runtime/webfonts/6.7.2/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yodawy-dashboard-dev",
      "database_id": "__DEV_D1_DATABASE_ID__",
      "migrations_dir": "./migrations"
    }
  ]
}
