{
  "provider": "github",
  "owner": "m-saleh-yodawy",
  "branch": "main",
  "systemAuth": {
    "repository": "YODAWY_DASHBOARD_REPOSITORY",
    "tokenCheck": "repository_access"
  },
  "userRegistry": {
    "repository": "YODAWY_DASHBOARD_REPOSITORY",
    "path": "CONFIG/users.json"
  },
  "personalAuth": {
    "enabled": true,
    "repositoryFromUserRegistry": true
  },
  "dashboard": {
    "repository": "YODAWY_DASHBOARD_REPOSITORY",
    "branch": "main",
    "messagesPath": "AUTH/auth-messages.json",
    "errorMessageEngine": {
      "path": "UI/error-message-engine.js"
    },
    "engines": {
      "USER": "ENGINES/user-engine.js",
      "ADMIN": "ENGINES/admin-engine.js",
      "SUPER_ADMIN": "ENGINES/super-admin-engine.js"
    }
  }
}
