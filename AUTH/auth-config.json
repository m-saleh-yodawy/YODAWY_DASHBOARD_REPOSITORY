{
  "provider": "github",
  "owner": "m-saleh-yodawy",
  "branch": "main",
  "systemAuth": {
    "repository": "YODAWY_DASHBOARD_REPOSITORY",
    "tokenCheck": "repository_access"
  },
  "userRegistry": {
    "repository": "YODAWY_DASHBOARD_REPOSITORY",
    "path": "CONFIG/users.json"
  },
  "personalAuth": {
    "enabled": true,
    "repositoryFromUserRegistry": true
  },
  "dashboard": {
    "repository": "YODAWY_DASHBOARD_REPOSITORY",
    "branch": "main",
    "messagesPath": "CONFIG/auth-messages.json"
  }
}
